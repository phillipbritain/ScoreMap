{
  "palette": {
    "gold": { "base": "#d4ac63" },
    "red": { "base": "#cd2435" },
    "orange": { "base": "#e56335" },
    "navy": { "base": "#2b4d7d" },
    "offWhite": { "base": "#f4f5f7" }
  },
  "settings": {
    "textSizes": { "xs": 11, "s": 12, "m": 14, "l": 16, "xl": 20 },
    "spacing": { "2xs": 2, "xs": 4, "s": 6, "m": 8, "l": 12, "xl": 16, "2xl": 24, "3xl": 32 },
    "radii": { "xs": 4, "s": 6, "m": 8, "l": 12, "pill": 999 },
    "strokes": { "thin": 1, "medium": 2, "thick": 3 },
    "globe": {
      "surface": "navy.500",
      "coastlines": { "color": "navy.300", "width": { "2": 0.6, "8": 1.2 } },
      "countryBorders": { "color": "navy.300", "width": { "2": 0.6, "8": 1.4 } },
      "stateLines": { "color": "navy.400", "width": { "3": 0.5, "8": 1 } },
      "disputedBorders": { "color": "navy.400", "width": { "0": 0.8 } },
      "halo": { "inner": "navy.400", "outer": "navy.700" }
    },
    "placeNames": {
      "city": {
        "color": "navy.200",
        "outline": { "color": "navy.600", "width": 2, "blur": 0.5 },
        "font": "Open Sans Semibold",
        "size": { "4": "s", "7": "m", "11": "xl" }
      },
      "capital": {
        "color": "navy.100",
        "outline": { "color": "navy.600", "width": 2, "blur": 0.5 },
        "font": "Open Sans Bold",
        "size": { "4": "m", "7": "l", "11": "xl" }
      },
      "state": {
        "color": "navy.300",
        "outline": { "color": "navy.600", "width": 1.2, "blur": 0 },
        "font": "Open Sans Regular",
        "size": { "3": "xs", "8": "m" }
      },
      "country": {
        "color": "navy.200",
        "outline": { "color": "navy.600", "width": 2, "blur": 0.5 },
        "font": "Open Sans Bold",
        "size": { "1": "xs", "4": "l" }
      }
    },
    "status": {
      "live": {
        "color": "gold.500",
        "core": { "color": "gold.100", "radius": 3.5, "opacity": 1, "ring": 1.5 },
        "glow": { "radius": 15, "opacity": 0.8 },
        "clusterOpacity": 1,
        "card": { "fade": 0, "glow": { "radius": 12, "opacity": 0.8 } }
      },
      "upcoming": {
        "color": "gold.500",
        "core": { "color": "gold.500", "radius": 3, "opacity": 0.9, "ring": 0 },
        "glow": { "radius": 9, "opacity": 0.4 },
        "clusterOpacity": 0.9,
        "card": { "fade": 0.15, "glow": { "radius": 4, "opacity": 0.3 } }
      },
      "final": {
        "color": "gold.500",
        "core": { "color": "gold.500", "radius": 2.5, "opacity": 0.5, "ring": 0 },
        "glow": { "radius": 0, "opacity": 0 },
        "clusterOpacity": 0.55,
        "card": { "fade": 0.45, "glow": { "radius": 0, "opacity": 0 } }
      },
      "disrupted": {
        "color": "offWhite.700",
        "core": { "color": "offWhite.700", "radius": 2.5, "opacity": 0.7, "ring": 0 },
        "glow": { "radius": 0, "opacity": 0 },
        "clusterOpacity": 0.6,
        "card": { "fade": 0.3, "glow": { "radius": 0, "opacity": 0 } }
      }
    },
    "cluster": {
      "fill": "navy.700",
      "radius": { "few": 11, "some": 13, "many": 16 },
      "glowRadius": { "few": 22, "some": 26, "many": 32 },
      "outlineWidth": 1.5,
      "glowOpacity": 0.6
    },
    "trail": {
      "width": 1.25,
      "opacity": 0.9,
      "glow": { "width": 4, "blur": 3, "opacity": 0.35 },
      "venue": { "radius": 2, "ring": { "radius": 5, "width": 1 } }
    },
    "selection": { "color": "offWhite.500", "width": 2 },
    "pulse": { "size": { "pin": 16, "cluster": 36 }, "ring": { "lively": 3, "calm": 2 } },
    "page": {
      "background": "navy.900",
      "sky": "navy.900",
      "stars": { "white": "offWhite.500", "cool": "navy.100", "warm": "gold.100" }
    },
    "text": {
      "main": "offWhite.500",
      "secondary": "offWhite.600",
      "accent": "offWhite.600",
      "link": "offWhite.500",
      "onStatus": "navy.800"
    },
    "divider": "navy.600",
    "hover": "navy.600",
    "controls": {
      "surface": "navy.800",
      "shadow": { "x": 0, "y": 0, "blur": 0, "color": "transparent" },
      "on": { "fill": "offWhite.500", "text": "navy.800" }
    },
    "card": {
      "fill": "navy.700",
      "text": "offWhite.500",
      "disrupted": { "fill": "navy.700", "text": "offWhite.700" },
      "shadow": "navy.900"
    },
    "panel": {
      "surface": { "top": "navy.800", "bottom": "navy.800" },
      "scoreBlock": { "top": "navy.700", "bottom": "navy.700" },
      "score": { "fill": "navy.600", "text": "offWhite.500" },
      "unofficial": "offWhite.600",
      "photo": "navy.600",
      "credit": { "fill": "navy.900", "text": "offWhite.600" },
      "close": "navy.700",
      "shadow": { "x": 0, "y": 0, "blur": 0, "color": "transparent" },
      "glow": { "y": 0, "blur": 0, "opacity": 0 }
    },
    "settingsMenu": {
      "surface": "navy.800",
      "shadow": { "x": 0, "y": 0, "blur": 0, "color": "transparent" },
      "gearOutline": { "x": 0, "y": 0, "blur": 0, "color": "transparent" },
      "tab": "offWhite.600",
      "count": "offWhite.600",
      "hint": "offWhite.600",
      "chip": { "outline": "navy.500", "badge": "navy.700" },
      "on": { "fill": "offWhite.500", "text": "navy.800" }
    },
    "fonts": {
      "body": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 400 },
      "heading": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 700 },
      "team": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 700 },
      "score": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 700 },
      "tab": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 600 },
      "button": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 600 },
      "scenarioPill": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 600 },
      "scenarioClock": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 400 },
      "card": {
        "clock": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 600 },
        "team": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 700 },
        "score": { "family": "'Open Sans Variable', 'Open Sans', sans-serif", "weight": 700 }
      },
      "clusterCount": { "font": "Open Sans Bold", "size": "s" }
    },
    "corners": { "card": "s", "panel": "m", "menu": "m", "menuItem": "s", "message": "m", "control": "pill" },
    "cutCorner": { "on": false, "size": "xl" },
    "sizes": {
      "panel": { "width": 940, "height": 127, "phoneHeight": 236, "scoreBlock": 290, "slant": 16, "photo": 180, "logo": 28, "close": 24 },
      "card": { "minWidth": 92, "logo": 16, "pointer": 6, "light": 6 },
      "settingsMenu": { "width": 320, "gear": 28, "allLeagues": 32 },
      "controls": { "key": 34, "icon": 14 }
    }
  }
}
