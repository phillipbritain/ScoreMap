{
  "colors": {
    "gold": { "base": "#d4ac63" },
    "red": { "base": "#cd2435" },
    "orange": { "base": "#e56335" },
    "navy": { "base": "#2b4d7d" },
    "offWhite": { "base": "#f4f5f7" }
  },
  "palette": {
    "primary": { "main": "navy.500", "light": "navy.300", "dark": "navy.700", "contrastText": "offWhite.500" },
    "secondary": { "main": "gold.500", "light": "gold.300", "dark": "gold.700", "contrastText": "navy.800" },
    "error": { "main": "red.500", "light": "red.300", "dark": "red.700", "contrastText": "offWhite.500" },
    "warning": { "main": "orange.500", "light": "orange.300", "dark": "orange.700", "contrastText": "navy.800" },
    "live": { "main": "gold.500", "light": "gold.300", "dark": "gold.700" },
    "upcoming": { "main": "gold.500", "light": "gold.300", "dark": "gold.700" },
    "final": { "main": "gold.500", "light": "gold.300", "dark": "gold.700" },
    "disrupted": { "main": "offWhite.700", "light": "offWhite.600", "dark": "offWhite.800" },
    "background": { "default": "navy.900", "paper": "navy.800" },
    "text": { "primary": "offWhite.500", "secondary": "offWhite.600", "link": "offWhite.500" },
    "divider": "navy.600",
    "action": { "hover": "navy.600" }
  },
  "typography": {
    "fontFamily": "'Open Sans Variable', 'Open Sans', sans-serif",
    "h6": { "fontWeight": 700, "fontSize": 20, "letterSpacing": 0 },
    "subtitle1": { "fontWeight": 700, "fontSize": 16, "letterSpacing": 0 },
    "subtitle2": { "fontWeight": 600, "fontSize": 12, "letterSpacing": 0 },
    "body1": { "fontWeight": 400, "fontSize": 16, "letterSpacing": 0 },
    "body2": { "fontWeight": 400, "fontSize": 14, "letterSpacing": 0 },
    "button": { "fontWeight": 600, "fontSize": 14, "letterSpacing": 0 },
    "caption": { "fontWeight": 400, "fontSize": 12, "letterSpacing": 0 },
    "overline": { "fontWeight": 700, "fontSize": 12, "letterSpacing": 0.14 },
    "footnote": { "fontWeight": 400, "fontSize": 11, "letterSpacing": 0 }
  },
  "spacing": 4,
  "shape": {
    "borderRadius": 4,
    "borderWidth": { "thin": 1, "medium": 2, "thick": 3 }
  },
  "components": {
    "Globe": {
      "surface": "primary.main",
      "coastlines": { "color": "primary.light", "width": { "2": 0.6, "8": 1.2 } },
      "countryBorders": { "color": "primary.light", "width": { "2": 0.6, "8": 1.4 } },
      "stateLines": { "color": "navy.400", "width": { "3": 0.5, "8": 1 } },
      "disputedBorders": { "color": "navy.400", "width": { "0": 0.8 }, "dash": [2, 2] },
      "halo": {
        "inner": { "color": "navy.400", "blur": { "share": 0.12, "max": 60 }, "spread": { "share": 0.04, "max": 20 } },
        "outer": { "color": "primary.dark", "blur": { "share": 0.35, "max": 160 }, "spread": { "share": 0.08, "max": 40 } }
      }
    },
    "PlaceNames": {
      "city": {
        "color": "navy.200",
        "outline": { "color": "navy.600", "width": 2, "blur": 0.5 },
        "font": "Open Sans Semibold",
        "size": { "4": "caption", "7": "body2", "11": "h6" },
        "letterSpacing": 0
      },
      "state": {
        "color": "primary.light",
        "outline": { "color": "navy.600", "width": 1.2, "blur": 0 },
        "font": "Open Sans Regular",
        "size": { "3": "footnote", "8": "body2" },
        "letterSpacing": 0.25
      },
      "country": {
        "color": "navy.200",
        "outline": { "color": "navy.600", "width": 2, "blur": 0.5 },
        "font": "Open Sans Bold",
        "size": { "1": "footnote", "4": "body1" },
        "letterSpacing": 0.12
      }
    },
    "Sky": {
      "color": "background.default",
      "stars": { "white": "offWhite.500", "cool": "navy.100", "warm": "gold.100", "size": { "small": 1, "large": 1.5 } }
    },
    "Pin": {
      "live": {
        "core": { "color": "gold.100", "radius": 3.5, "opacity": 1, "ring": 1.5 },
        "glow": { "radius": 15, "opacity": 0.8 }
      },
      "upcoming": {
        "core": { "color": "upcoming.main", "radius": 3, "opacity": 0.9, "ring": 0 },
        "glow": { "radius": 9, "opacity": 0.4 }
      },
      "final": {
        "core": { "color": "final.main", "radius": 2.5, "opacity": 0.5, "ring": 0 },
        "glow": { "radius": 0, "opacity": 0 }
      },
      "disrupted": {
        "core": { "color": "disrupted.main", "radius": 2.5, "opacity": 0.7, "ring": 0 },
        "glow": { "radius": 0, "opacity": 0 }
      }
    },
    "Cluster": {
      "fill": "primary.dark",
      "radius": { "few": 11, "some": 13, "many": 16 },
      "glowRadius": { "few": 22, "some": 26, "many": 32 },
      "outlineWidth": 1.5,
      "glowOpacity": 0.6,
      "count": { "font": "Open Sans Bold", "size": "caption" },
      "live": { "opacity": 1 },
      "upcoming": { "opacity": 0.9 },
      "final": { "opacity": 0.55 },
      "disrupted": { "opacity": 0.6 }
    },
    "Trail": {
      "width": 1.25,
      "opacity": 0.63,
      "glow": { "width": 4, "blur": 3, "opacity": 0.25 },
      "venue": { "radius": 2, "ring": { "radius": 5, "width": 1 } }
    },
    "Selection": { "color": "offWhite.500", "width": 2 },
    "Hover": {
      "card": { "borderWidth": 2.5, "solid": true },
      "trail": { "width": 2.5, "opacity": 1 },
      "venue": { "radius": 3.5, "glow": { "radius": 12, "opacity": 0.6 } }
    },
    "Pulse": { "size": { "pin": 16, "cluster": 36 }, "ring": { "lively": 3, "calm": 2 } },
    "ScoreCard": {
      "fill": "primary.dark",
      "text": "text.primary",
      "shadow": "background.default",
      "fillOpacity": 0.75,
      "header": { "tint": 0.28, "letterSpacing": 0.06 },
      "corner": 1.5,
      "size": { "minWidth": 92, "logo": 16, "venueGap": 16, "light": 6, "nameClearance": 4 },
      "logo": { "plate": { "fill": "offWhite.500", "padding": 0.5, "corner": 0.5 } },
      "live": { "fade": 0, "glow": { "radius": 12, "opacity": 0.8 } },
      "upcoming": { "fade": 0.15, "glow": { "radius": 4, "opacity": 0.3 } },
      "final": { "fade": 0.45, "glow": { "radius": 0, "opacity": 0 } },
      "disrupted": { "fill": "primary.dark", "text": "offWhite.700", "fade": 0.3, "glow": { "radius": 0, "opacity": 0 } }
    },
    "GamePanel": {
      "surface": { "top": "background.paper", "bottom": "background.paper" },
      "scoreBlock": { "top": "primary.dark", "bottom": "primary.dark" },
      "score": { "fill": "navy.600", "text": "text.primary" },
      "unofficial": "text.secondary",
      "photo": "navy.600",
      "credit": { "fill": "background.default", "text": "text.secondary" },
      "close": "primary.dark",
      "shadow": { "x": 0, "y": 0, "blur": 0, "color": "transparent" },
      "glow": { "y": 0, "blur": 0, "opacity": 0 },
      "corner": 2,
      "cutCorner": { "on": false, "size": 4 },
      "logo": { "plate": { "fill": "offWhite.500", "padding": 1, "corner": 1 } },
      "size": {
        "width": 940,
        "height": 127,
        "phoneHeight": 236,
        "scoreBlock": 290,
        "slant": 16,
        "photo": 180,
        "logo": 28,
        "close": 24,
        "scoreWidth": 2.6
      }
    },
    "Menu": { "corner": 2 },
    "MenuItem": { "corner": 1.5 },
    "Rail": {
      "surface": "background.paper",
      "shadow": { "x": 0, "y": 0, "blur": 0, "color": "transparent" },
      "toggle": { "on": "secondary.main", "off": "text.secondary" },
      "count": "text.secondary",
      "hint": "text.secondary",
      "chip": { "outline": "primary.main", "badge": "primary.dark" },
      "on": { "fill": "offWhite.500", "text": "navy.800" },
      "size": { "button": 36, "icon": 18, "width": 320, "allLeagues": 32, "countWidth": 3.2, "mark": 1 }
    },
    "Controls": {
      "surface": "background.paper",
      "shadow": { "x": 0, "y": 0, "blur": 0, "color": "transparent" },
      "on": { "fill": "offWhite.500", "text": "navy.800" },
      "off": { "opacity": 0.6 },
      "corner": "pill",
      "message": { "corner": 2 },
      "size": { "key": 34, "icon": 14 }
    },
    "LoadingScreen": {
      "dim": { "color": "background.default", "opacity": 0.6 },
      "spinner": { "color": "text.primary", "track": "navy.600", "size": 32 },
      "message": "text.primary"
    }
  }
}
